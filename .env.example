# 复制为 .env.local 后填写本机绝对路径；在仓库根目录手动 source ./.env.local。
# 训练和部署脚本不会自动加载本文件。路径含空格时保留引号。
export H7_REPO_PATH="/absolute/path/to/Wheel-Legged-Gym/deployment/H7_RL"
# 必须是装有 Isaac Gym 的 Python 3.8 conda 环境，不能填系统 Python。
export WHEELLEGGED_PYTHON="/absolute/path/to/conda/envs/wheellegged_py38/bin/python"
