-        }
-    }
-    return 0u;
-}
-
-/* 完整自重摆矩 */
-/*
- * 由腿长查询/插值质心半径和偏角，按世界腿角计算自重摆矩。
- * 超表域取边界并标记clamped；结果是摆矩，不是额外支撑轴向力。
- */
-uint8_t Gravity_Comp_Compute(const machine_gravity_cfg_t *cfg,
-    float length, float world_angle, gravity_leg_result_t *result)
