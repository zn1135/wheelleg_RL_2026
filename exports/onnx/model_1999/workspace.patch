+    frame[29] = (float)valid_mask;
+    frame[30] = Jetson_Publication_Age(&feedback.imu_meta, feedback.captured_ns);
+    frame[31] = Jetson_Publication_Age(&feedback.motor_meta, feedback.captured_ns);
