-            if (!Leg_Force_Map_Forward(leg[side], -result->force[side], 0.0f, &result->delta_dm[side * 2u]) || !isfinite(result->delta_dm[side * 2u]) || !isfinite(result->delta_dm[side * 2u + 1u]))
-            {
-                return;
-            }
-#endif
-        }
-    }
-    result->valid = 1u;
