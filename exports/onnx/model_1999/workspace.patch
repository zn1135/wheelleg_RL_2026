-        else
-        {
-            cmd->mode.strategy = CTRL_STRATEGY_LQR;
-            cmd->mode.rc_enable = machine->lqr_configured;
-            cmd->mode.engage = (uint8_t)(cmd->s2 == DR16_SW_MID);
