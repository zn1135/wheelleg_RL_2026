-    uint8_t request;
-
-    recovery = rl_control.recovery;
-    previous = recovery.phase;
-    request = (uint8_t)(control_frame.rc.online && control_frame.rc.mode.rc_enable && control_frame.rc.mode.strategy == CTRL_STRATEGY_RL && control_frame.rc.mode.engage);
