-    lb->F[1] = F[1];
-    lb->Tp[0] = Tp[0];
-    lb->Tp[1] = Tp[1];
-
-    /* 轮扭矩 (输出极性在 dji.c 驱动边界统一处理) */
-    torque->dji[DJI_MOTOR_WHEEL_LFT] = clampf(wheel[0], -config->trq_max_wheel, config->trq_max_wheel);
