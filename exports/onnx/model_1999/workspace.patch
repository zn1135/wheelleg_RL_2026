-function s = fmt_float(v)
-% 先舍入到 single 再以 9 位有效数字打印: C 端解析回来就是同一个 float
-s = sprintf('%.9g', double(single(v)));
-if isempty(regexp(s, '[.eE]', 'once')), s = [s '.0']; end
-s = [s 'F'];
-end
